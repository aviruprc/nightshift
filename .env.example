# Optional settings for nightshift. Copy to `.env` in the project folder (it is git-ignored) and uncomment what you need.
# Values already set in your environment win over this file. NEVER commit a real .env.

# --- your profile (defaults shown) ---
# JOBHUNT_FACTS=cv/facts.yaml
# JOBHUNT_ANSWERS=data/answers.yaml
# JOBHUNT_EMAIL=you@example.com            # overrides personal.email for portal logins and the mailbox the bot reads

# --- mailbox (receipts, verification codes, password-reset links) ---
# JOBHUNT_IMAP_HOST=imap.gmail.com         # any IMAP server with app-password login; the password itself is stored with `python hunt.py gmail-setup`

# --- AI provider keys ---
# Preferred: `python hunt.py llm-key --provider <name>` stores the key in your OS credential store (Windows Credential Manager).
# Alternative (e.g. where no credential store is available): one variable per provider name in data/llm_providers.json,
# upper-cased with non-letters as underscores:
# JOBHUNT_KEY_GEMINI=
# JOBHUNT_KEY_GROQ=
# JOBHUNT_KEY_DEEPSEEK_API=

# --- browser ---
# JOBHUNT_PROFILE=data/browser_profile      # the persistent Chrome profile the bot signs in with
# JOBHUNT_SKIP_NAUKRI=1                     # do not use Naukri at all
# JOBHUNT_SKIP_WORKDAY=1                    # do not apply on Workday portals
